# Copy this file to .env and fill in real values only on the server — never commit .env.

# Supabase Postgres connection (Project Settings > Database > Connection string).
# DATABASE_URL: pooled connection (PgBouncer, port 6543) — used by the running app.
# DIRECT_URL: direct connection (port 5432) — used by `prisma migrate`.
DATABASE_URL=postgresql://postgres:<password>@<project-ref>.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:<password>@<project-ref>.pooler.supabase.com:5432/postgres

# Supabase Storage (Project Settings > API). Service role key is server-only — never ship it to the frontend.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=project-assets

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_MAX_OUTPUT_TOKENS=700

# Server
PORT=4000
# 0.0.0.0 for cloud hosting (Railway 등); 127.0.0.1 is fine for local-only dev.
HOST=0.0.0.0
# Comma-separated list of allowed frontend origins for CORS.
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
