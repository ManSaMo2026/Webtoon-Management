generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  penName      String   @default("") @map("pen_name")
  role         String   @default("작가")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  sessions Session[]
  projects Project[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Project {
  id              String    @id @default(cuid())
  userId          String    @map("user_id")
  title           String
  coverImageUrl   String?   @map("cover_image_url")
  coverStorageKey String?   @map("cover_storage_key")
  platform        String?
  tags            String[]  @default([])
  genre           String
  customGenre     String?   @map("custom_genre")
  totalEpisodes   Int       @map("total_episodes")
  currentEpisode  Int       @default(0) @map("current_episode")
  cadence         String
  weeklyHours     Float     @map("weekly_hours")
  avgCuts         Int       @map("avg_cuts")
  colorMode       String    @map("color_mode")
  bgComplexity    String    @map("bg_complexity")
  hasAssistant    Boolean   @default(false) @map("has_assistant")
  logline         String
  conflict        String
  nextDeadline    DateTime  @map("next_deadline")
  completionDate  DateTime? @map("completion_date")
  status          String?
  customStatus    String?   @map("custom_status")
  successRate     Int       @map("success_rate")
  riskLevel       String    @map("risk_level")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  characters        Character[]
  episodes          Episode[]
  foreshadows       Foreshadow[]
  storyAct          StoryAct?
  worldSetting      WorldSetting?
  worldPlaceRefs    WorldPlaceReference[]
  todos             Todo[]
  timelineItems     TimelineItem[]
  relationshipBoard RelationshipBoard?
  aiUsageEvents     AiUsageEvent[]
  aiChatMessages    AiChatMessage[]

  @@index([userId])
  @@index([userId, updatedAt])
  @@map("projects")
}

model Character {
  id            String   @id @default(cuid())
  projectId     String   @map("project_id")
  name          String
  role          String
  roleGroup     String?  @map("role_group")
  personality   String
  goal          String
  speechStyle   String   @map("speech_style")
  taboo         String
  secret        String
  keywords      String[] @default([])
  imageUrl      String?  @map("image_url")
  storageKey    String?  @map("storage_key")
  gender        String?
  age           String?
  origin        String?
  occupation    String?
  likes         String?
  dislikes      String?
  backstory     String?
  relationships String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  project     Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  foreshadows ForeshadowCharacter[]

  @@index([projectId])
  @@index([projectId, roleGroup])
  @@map("characters")
}

model Episode {
  id        String @id @default(cuid())
  projectId String @map("project_id")
  number    Int
  summary   String
  purpose   String
  hook      String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, number])
  @@map("episodes")
}

model Foreshadow {
  id         String   @id @default(cuid())
  projectId  String   @map("project_id")
  content    String
  keyword    String?
  importance String?
  appearEp   Int      @map("appear_ep")
  resolveEp  Int?     @map("resolve_ep")
  status     String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  project    Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  characters ForeshadowCharacter[]

  @@index([projectId])
  @@map("foreshadows")
}

model ForeshadowCharacter {
  foreshadowId String @map("foreshadow_id")
  characterId  String @map("character_id")

  foreshadow Foreshadow @relation(fields: [foreshadowId], references: [id], onDelete: Cascade)
  character  Character  @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@id([foreshadowId, characterId])
  @@map("foreshadow_characters")
}

model StoryAct {
  projectId String   @id @map("project_id")
  act1      String
  act2      String
  act3      String
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("story_acts")
}

model WorldSetting {
  projectId         String   @id @map("project_id")
  era               String
  mainPlaces        String   @map("main_places")
  worldRules        String   @map("world_rules")
  organizations     String
  culture           String
  technologyOrMagic String   @map("technology_or_magic")
  moodTone          String   @map("mood_tone")
  forbiddenSettings String   @map("forbidden_settings")
  researchNotes     String?  @map("research_notes")
  referenceSources  String?  @map("reference_sources")
  updatedAt         DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("world_settings")
}

model WorldPlaceReference {
  id         String   @id @default(cuid())
  projectId  String   @map("project_id")
  imageUrl   String   @map("image_url")
  storageKey String   @map("storage_key")
  memo       String   @default("")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("world_place_references")
}

model Todo {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  content   String
  done      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("todos")
}

model TimelineItem {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  title     String
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("timeline_items")
}

model RelationshipBoard {
  projectId       String   @id @map("project_id")
  nodesJson       Json     @default("[]") @map("nodes_json")
  connectionsJson Json     @default("[]") @map("connections_json")
  notesJson       Json     @default("[]") @map("notes_json")
  version         Int      @default(1)
  updatedAt       DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("relationship_boards")
}

model AiUsageEvent {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  projectId    String?  @map("project_id")
  task         String
  model        String
  inputTokens  Int?     @map("input_tokens")
  outputTokens Int?     @map("output_tokens")
  createdAt    DateTime @default(now()) @map("created_at")

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("ai_usage_events")
}

model AiChatMessage {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  area      String
  role      String
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, area, createdAt])
  @@map("ai_chat_messages")
}
